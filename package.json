  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@types/react": "^19.1.8",
    "@tauri-apps/api": "^2"
  },
  "peerDependencies": {
    "react": ">=18",
    "@tauri-apps/api": "^2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "exports": {
    ".": "./src/visualizer.ts",
    "./react": "./src/react/Visualizer.tsx",
    "./sources/tauri": "./src/sources/tauri.ts",
    "./sources/webaudio": "./src/sources/webaudio.ts",
    "./render": "./src/render/renderer.ts"
